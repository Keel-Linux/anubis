#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/buildopts.mk

# Go 1.27.3 or newer is required by go.mod; trixie has it in
# trixie-backports (golang-1.27-go), which installs under /usr/lib/go-1.27.
# _build/shim holds the wasm2js wrapper (override_dh_auto_build).
export PATH := $(CURDIR)/_build/shim:/usr/lib/go-1.27/bin:$(PATH)

# Never fetch: every Go module is in vendor/ and every JavaScript
# dependency is in npm/ (the npm component of the source).
export GOTOOLCHAIN := local
export GOPROXY := off
# At most GO_MAX_PARALLEL packages are compiled, linked and tested at the
# same time (go -p), not one for each CPU. Measured with Go 1.27 on this
# source: a link of a test binary takes about 290 MiB on average and up to
# 570 MiB, and the compile of the largest vendored package (go-redis) about
# 1060 MiB. On a CI runner with 24 CPUs, 18 links and some compiles at the
# same time went above the 1792 MiB that the runner gives a job, and the
# job was killed. With 2, the worst case is that compile and one link,
# about 1630 MiB, and two links take at most about 1150 MiB.
# DEB_BUILD_OPTIONS=parallel=1 sets a lower number.
GO_MAX_PARALLEL := 2
GO_PARALLEL := $(shell n='$(DEB_BUILD_OPTION_PARALLEL)'; \
	if [ -n "$$n" ] && [ "$$n" -lt $(GO_MAX_PARALLEL) ]; then echo "$$n"; \
	else echo $(GO_MAX_PARALLEL); fi)
export GOFLAGS := -mod=vendor -trimpath -buildvcs=false -p=$(GO_PARALLEL)
export GOCACHE := $(CURDIR)/_build/go-cache
export GOPATH := $(CURDIR)/_build/gopath
export XDG_CACHE_HOME := $(CURDIR)/_build/cache
export CGO_ENABLED := 0
export NODE_PATH := $(CURDIR)/npm
export SKIP_INTEGRATION := 1

GO_LDFLAGS := -X 'github.com/TecharoHQ/anubis.Version=$(DEB_VERSION_UPSTREAM)'

# Files the build generates outside _build, removed by clean.
GENERATED := web/static/js web/static/locales web/static/wasm \
	web/js/gen lib/challenge/preact/static lib/challenge/challengepage/static/js \
	xess/xess.min.css

# Packages whose tests need the network, a browser or a container runtime.
TEST_SKIP := /internal/test$$|/cmd/containerbuild$$|/internal/dnsbl$$

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	# Upstream's "assets" target (Makefile) without npm and cargo: go
	# generate runs templ, stringer and the challenge build.sh scripts with
	# trixie's esbuild; xess is built with esbuild instead of postcss and
	# cssnano, which Debian does not have, inlining the fonts as postcss-url
	# did.
	go generate ./...
	# The WebAssembly proof-of-work modules are not built here: they come
	# from the wasm-modules component, upstream's own build
	# (debian/README.source). wasm2js turns the baseline ones into the
	# JavaScript fallback for browsers without WebAssembly. It is upstream's
	# pinned binaryen 130 build in the source (utils/wasm/wasm2js), run with
	# the vendored wazero: the shim makes build_wasm2js.sh take that path
	# whatever else the machine has (trixie's binaryen 120 is too old).
	mkdir -p web/static/wasm _build/bin _build/shim
	cp -r wasm-modules/baseline wasm-modules/simd128 web/static/wasm/
	cd web/static/wasm && sha256sum --check --quiet ../../../wasm-modules/SHA256SUMS
	go build -o _build/bin/wazero-exec ./utils/cmd/wazero-exec
	printf '#!/bin/sh\nexec "%s/_build/bin/wazero-exec" "%s/utils/wasm/wasm2js/wasm2js_130.wasm" "$$@"\n' \
		"$(CURDIR)" "$(CURDIR)" > _build/shim/wasm2js
	chmod +x _build/shim/wasm2js
	bash ./wasm/scripts/build_wasm2js.sh
	./web/build.sh
	esbuild xess/xess.css --bundle --minify --loader:.woff2=dataurl \
		--outfile=xess/xess.min.css
	mkdir -p _build/bin
	go build -ldflags "$(GO_LDFLAGS)" -o _build/bin/anubis ./cmd/anubis
	go build -ldflags "$(GO_LDFLAGS)" -o _build/bin/anubis-robots2policy ./cmd/robots2policy

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	go test -count=1 $$(go list ./... | grep -Ev '$(TEST_SKIP)')
endif

override_dh_auto_install:

# dwz does not understand Go's DWARF; dh-golang skips it too.
override_dh_dwz:

# The binaries are static Go: record the toolchain they embed, as
# dh-golang's misc:Static-Built-Using does (the modules are in vendor/,
# part of this source).
override_dh_gencontrol:
	dh_gencontrol -- "-Vmisc:Static-Built-Using=$$(dpkg-query -W -f='$${source:Package} (= $${source:Version})' golang-1.27-go)"

# Apache-2.0, section 4(d): the NOTICE files of the vendored modules go
# with the binaries built from them.
execute_after_dh_installdocs:
	cd vendor && find . \( -name NOTICE -o -name NOTICE.txt \) -print | \
		while read -r f; do \
			install -D -m 0644 "$$f" "../debian/anubis/usr/share/doc/anubis/vendor/$$f"; \
		done

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

override_dh_auto_clean:
	rm -rf _build $(GENERATED)
	find web/static lib/challenge -name '*.gz' -o -name '*.zst' -o -name '*.br' | xargs rm -f
