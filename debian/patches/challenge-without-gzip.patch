+// TestNonGzipClientGetsChallenge makes sure that a client which does not
+// advertise gzip in Accept-Encoding is handed the challenge like any other,
+// every time, instead of an error page for one request in 64 at random.
+func TestNonGzipClientGetsChallenge(t *testing.T) {
+	pol := loadPolicies(t, "testdata/aggressive_403.yaml", 0)
+
+	srv := spawnAnubis(t, Options{
+		Next:   http.NewServeMux(),
+		Policy: pol,
+	})
+
+	const requests = 4096
+
+	for _, encoding := range []string{"", "identity", "br"} {
+		for i := 0; i < requests; i++ {
+			req := httptest.NewRequest("GET", "http://example.com/", nil)
+			req.Header.Set("X-Real-IP", "127.0.0.1")
+			req.Header.Set("User-Agent", "CHALLENGE")
+			if encoding != "" {
+				req.Header.Set("Accept-Encoding", encoding)
+			}
+
+			w := httptest.NewRecorder()
+			srv.maybeReverseProxyOrPage(w, req)
+
+			if w.Code != pol.StatusCodes.Challenge {
+				t.Fatalf("Accept-Encoding %q, request %d: got status %d, wanted %d (challenge)", encoding, i, w.Code, pol.StatusCodes.Challenge)
+			}
+		}
+	}
+}
