--- a/cmd/anubis/main.go
+++ b/cmd/anubis/main.go
@@ -119,6 +119,25 @@ func doHealthCheck() error {
 	return nil
 }
 
+// parseRedirectDomains splits REDIRECT_DOMAINS on commas and checks each
+// entry. An entry is a host as it appears in a URL, so an IPv6 literal is
+// bracketed, [2001:db8::1]; url.Parse alone refuses that ("first path
+// segment in URL cannot contain colon"), so an entry is accepted when it
+// parses as the host of a URL, or, as before, as a URL.
+func parseRedirectDomains(s string) ([]string, error) {
+	var domains []string
+	for domain := range strings.SplitSeq(s, ",") {
+		domain = strings.TrimSpace(domain)
+		if _, err := url.Parse("//" + domain); err != nil {
+			if _, err := url.Parse(domain); err != nil {
+				return nil, fmt.Errorf("cannot parse redirect-domain %q: %w", domain, err)
+			}
+		}
+		domains = append(domains, domain)
+	}
+	return domains, nil
+}
