--- a/cmd/anubis/main_test.go
+++ b/cmd/anubis/main_test.go
@@ -4,9 +4,28 @@ import (
 	"net/http"
 	"net/http/httptest"
 	"net/url"
+	"slices"
 	"testing"
 )
 
+// TestParseRedirectDomains makes sure that REDIRECT_DOMAINS takes an IPv6
+// literal the way it appears as the host of a URL, [2001:db8::1], next to
+// names and globs, and still refuses what no host can be.
+func TestParseRedirectDomains(t *testing.T) {
+	got, err := parseRedirectDomains("web, web.example.org,10.0.3.158,[fd42:b2:0:1::6554],*.example.org")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	want := []string{"web", "web.example.org", "10.0.3.158", "[fd42:b2:0:1::6554]", "*.example.org"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+
+	if _, err := parseRedirectDomains("web,%zz"); err == nil {
+		t.Fatal("an unparseable domain was accepted")
+	}
+}
