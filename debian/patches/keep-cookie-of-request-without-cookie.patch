@@ -0,0 +1,60 @@
+package lib
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/TecharoHQ/anubis"
+	"github.com/TecharoHQ/anubis/internal"
+)
+
+// clearsAuthCookie reports whether resp clears the auth cookie of srv.
+func clearsAuthCookie(srv *Server, resp *http.Response) bool {
+	for _, c := range resp.Cookies() {
+		if c.Name == srv.cookieName(anubis.CookieName) && c.MaxAge < 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func challengeRequest(t *testing.T, ts *httptest.Server, cookie *http.Cookie) *http.Response {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, ts.URL+"/style.css", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("User-Agent", "Mozilla/5.0 (X11; Linux x86_64) Chrome/140.0.0.0")
+	if cookie != nil {
+		req.AddCookie(cookie)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	return resp
+}
+
+// A request that sent no Anubis cookie gets the challenge and no Set-Cookie
+// that clears the cookie: that answer may reach the browser after the
+// answer of pass-challenge and delete the cookie it just set. A request
+// that sent an invalid cookie still gets it cleared.
+func TestNoClearCookieWithoutCookie(t *testing.T) {
+	srv := spawnAnubis(t, Options{
+		Next:   http.NewServeMux(),
+		Policy: loadPolicies(t, "", 4),
+	})
+	ts := httptest.NewServer(internal.RemoteXRealIP(true, "tcp", srv))
+	defer ts.Close()
+
+	if resp := challengeRequest(t, ts, nil); clearsAuthCookie(srv, resp) {
+		t.Errorf("a request without the cookie got a Set-Cookie that clears it: %v", resp.Header.Values("Set-Cookie"))
+	}
+
+	bad := &http.Cookie{Name: srv.cookieName(anubis.CookieName), Value: "not-a-jwt"}
+	if resp := challengeRequest(t, ts, bad); !clearsAuthCookie(srv, resp) {
+		t.Errorf("a request with an invalid cookie did not get it cleared: %v", resp.Header.Values("Set-Cookie"))
+	}
+}
