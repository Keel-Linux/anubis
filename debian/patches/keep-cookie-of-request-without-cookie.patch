 	ckie, err := s.getCookie(r, anubis.CookieName)
 	if err != nil {
 		lg.DebugContext(r.Context(), "cookie not found", "path", r.URL.Path)
-		s.ClearCookie(w, CookieOpts{Path: cookiePath, Host: r.Host})
+		// No cookie came with the request, so there is none to clear. A
+		// Set-Cookie that clears it here can remove the cookie that a
+		// pass-challenge answer gave the browser at the same time: a
+		// subresource of the challenge page, sent before the browser had
+		// the cookie, is answered after it.
 		s.RenderIndex(w, r, cr, rule, httpStatusOnly)
 		return
