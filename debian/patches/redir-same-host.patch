Description: Redirect only to the request's own origin while REDIRECT_DOMAINS is empty
 PassChallenge sends the client to redir once the challenge is solved.
 With REDIRECT_DOMAINS empty it compared the host of redir with itself
 (r.URL is redir, parsed again), so any host passed: an open redirect.
 REDIRECT_DOMAINS closes it only for the names written in it, and Keel
 Web's sites are reached by names and addresses the machine cannot list
 ahead of time (a new DNS name, a site of handbook decision 0042, a
 cloud public IP behind NAT).
 .
 redirectAllowed now decides: never a URL with userinfo; always a
 relative one, as before; with REDIRECT_DOMAINS set, a host in it, as
 before; with it empty, only the scheme, host and port of the request
 itself (X-Forwarded-Proto or http, and the Host header, default ports
 filled in), so every name the site is reached by works and no other
 host can be reached through it. TestRedirectAllowed covers the same
 host by name, by an unlisted name, by IPv4 and by an IPv6 literal, and
 refuses another host, a scheme-relative //evil, userinfo, another port
 and another scheme.
Author: Marcos Mendez <mendez.foto@gmail.com>
Bug: https://github.com/Keel-Linux/keel-web/pull/3
Forwarded: no
Last-Update: 2026-10-02
---
--- a/lib/anubis.go
+++ b/lib/anubis.go
@@ -496,6 +496,59 @@ func (s *Server) MakeChallenge(w http.Re
 	}
 }
 
+// redirectAllowed says whether pass-challenge may send the client to
+// redir. A URL with userinfo never. A relative URL (no host, no scheme)
+// always, as before. An absolute one: when allowed (REDIRECT_DOMAINS) is
+// set, when its host is in it, as before; when it is empty, only when its
+// scheme, host and port are those of the request (X-Forwarded-Proto, or
+// http, and the Host header), so every name the site is reached by works
+// and no other host can be reached through it. Upstream compared the host
+// of redir with itself there, which let any host through.
+func redirectAllowed(r *http.Request, redir *url.URL, allowed []string) bool {
+	if redir.User != nil {
+		return false
+	}
+	if redir.Host == "" {
+		return redir.Scheme == ""
+	}
+	if len(allowed) != 0 {
+		return matchRedirectDomain(allowed, redir.Host)
+	}
+	scheme := requestScheme(r)
+	if redir.Scheme != "" && !strings.EqualFold(redir.Scheme, scheme) {
+		return false
+	}
+	return sameHostPort(redir.Host, r.Host, scheme)
+}
+
+// requestScheme is the scheme the client used: the X-Forwarded-Proto of
+// the proxy in front when it is http or https, else that of the
+// connection.
+func requestScheme(r *http.Request) string {
+	switch proto := strings.ToLower(r.Header.Get("X-Forwarded-Proto")); proto {
+	case "http", "https":
+		return proto
+	}
+	if r.TLS != nil {
+		return "https"
+	}
+	return "http"
+}
+
+// sameHostPort compares two URL hosts, case-insensitively, with the
+// scheme's default port filled in where none is written.
+func sameHostPort(a, b, scheme string) bool {
+	canonical := func(host string) string {
+		u := url.URL{Host: host}
+		port := u.Port()
+		if port == "" {
+			port = map[string]string{"http": "80", "https": "443"}[scheme]
+		}
+		return net.JoinHostPort(strings.ToLower(u.Hostname()), port)
+	}
+	return b != "" && canonical(a) == canonical(b)
+}
+
