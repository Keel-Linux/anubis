@@ -0,0 +1,146 @@
+package lib
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/TecharoHQ/anubis"
+	"github.com/TecharoHQ/anubis/internal"
+)
+
+// TestRedirectAllowed makes sure that, while REDIRECT_DOMAINS is empty,
+// pass-challenge redirects only to the origin the request came to
+// (scheme, host and port), or to a relative URL, so that every name the
+// site is reached by works and the open redirect stays closed; and that
+// a configured REDIRECT_DOMAINS still decides as before.
+func TestRedirectAllowed(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		host    string
+		proto   string
+		redir   string
+		domains []string
+		want    bool
+	}{
+		{name: "relative path", host: "web.example.org", proto: "https", redir: "/page?x=1", want: true},
+		{name: "same host", host: "web.example.org", proto: "https", redir: "https://web.example.org/page", want: true},
+		{name: "same host, other case", host: "Web.Example.org", proto: "https", redir: "https://web.example.ORG/", want: true},
+		{name: "same host, default port written", host: "web.example.org", proto: "https", redir: "https://web.example.org:443/", want: true},
+		{name: "a name not in /etc/hosts", host: "unlisted.keel.test", proto: "https", redir: "https://unlisted.keel.test/", want: true},
+		{name: "same IPv4", host: "10.0.3.86", proto: "https", redir: "https://10.0.3.86/", want: true},
+		{name: "same IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[fd42:b2:0:1::6554]/x", want: true},
+		{name: "same IPv6 literal, default port written", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[fd42:b2:0:1::6554]:443/", want: true},
+		{name: "other IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[2001:db8::1]/", want: false},
+		{name: "other host", host: "web.example.org", proto: "https", redir: "https://evil.example/", want: false},
+		{name: "scheme-relative other host", host: "web.example.org", proto: "https", redir: "//evil.example/", want: false},
+		{name: "userinfo naming the host", host: "web.example.org", proto: "https", redir: "https://web.example.org@evil.example/", want: false},
+		{name: "userinfo on the same host", host: "web.example.org", proto: "https", redir: "https://a@web.example.org/", want: false},
+		{name: "other port", host: "web.example.org", proto: "https", redir: "https://web.example.org:8443/", want: false},
+		{name: "other scheme", host: "web.example.org", proto: "https", redir: "http://web.example.org/", want: false},
+		{name: "no X-Forwarded-Proto is http", host: "web.example.org", proto: "", redir: "http://web.example.org/", want: true},
+		{name: "no Host header", host: "", proto: "https", redir: "https://web.example.org/", want: false},
+		{name: "a scheme with no host", host: "web.example.org", proto: "https", redir: "https:/page", want: false},
+		{name: "REDIRECT_DOMAINS allows a listed host", host: "web.example.org", proto: "https", redir: "https://other.example/", domains: []string{"other.example"}, want: true},
+		{name: "REDIRECT_DOMAINS refuses the request's own host when unlisted", host: "web.example.org", proto: "https", redir: "https://web.example.org/", domains: []string{"other.example"}, want: false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			req := httptest.NewRequest("GET", "/.within.website/x/cmd/anubis/api/pass-challenge", nil)
+			req.Host = tt.host
+			if tt.proto != "" {
+				req.Header.Set("X-Forwarded-Proto", tt.proto)
+			}
+			redir, err := url.Parse(tt.redir)
+			if err != nil {
+				t.Fatalf("cannot parse %q: %v", tt.redir, err)
+			}
+			if got := redirectAllowed(req, redir, tt.domains); got != tt.want {
+				t.Errorf("redirectAllowed(Host %q, %q) = %v, want %v", tt.host, tt.redir, got, tt.want)
+			}
+		})
+	}
+}
+
+// TestPassChallengeRedirectsToOwnOriginOnly drives pass-challenge with
+// REDIRECT_DOMAINS empty, through both of its redirects to redir: the one
+// after a solved challenge (verification cookie present) and the retry of
+// a missing verification cookie. Another host is refused with 400 before
+// either redirect, and no auth cookie is set; the request's own origin
+// and a relative path are followed.
+func TestPassChallengeRedirectsToOwnOriginOnly(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		host       string // Host header; empty is the test server's own
+		proto      string
+		redir      string // "SELF" is replaced by http://<test server host>
+		withCookie bool
+		wantStatus int
+	}{
+		{name: "solved, relative", redir: "/page", withCookie: true, wantStatus: http.StatusFound},
+		{name: "solved, own origin", redir: "SELF/page", withCookie: true, wantStatus: http.StatusFound},
+		{name: "solved, other host", redir: "http://evil.example/", withCookie: true, wantStatus: http.StatusBadRequest},
+		{name: "solved, own host by another port", redir: "http://127.0.0.1:1/", withCookie: true, wantStatus: http.StatusBadRequest},
+		{name: "solved, own IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[fd42:b2:0:1::6554]/x", withCookie: true, wantStatus: http.StatusFound},
+		{name: "solved, other IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[2001:db8::1]/", withCookie: true, wantStatus: http.StatusBadRequest},
+		{name: "retry, own origin", redir: "SELF/page", wantStatus: http.StatusFound},
+		{name: "retry, other host", redir: "http://evil.example/", wantStatus: http.StatusBadRequest},
+		{name: "retry, other IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[2001:db8::1]/", wantStatus: http.StatusBadRequest},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := spawnAnubis(t, Options{Next: http.NewServeMux(), Policy: loadPolicies(t, "testdata/zero_difficulty.yaml", 0)})
+			ts := httptest.NewServer(internal.RemoteXRealIP(true, "tcp", srv))
+			t.Cleanup(ts.Close)
+
+			c := makeChallenge(t, ts, httpClient(t))
+			redir := strings.Replace(tt.redir, "SELF", ts.URL, 1)
+
+			q := url.Values{}
+			q.Set("id", c.ID)
+			q.Set("response", internal.SHA256sum(c.Challenge+"0"))
+			q.Set("nonce", "0")
+			q.Set("redir", redir)
+			q.Set("elapsedTime", "420")
+
+			req, err := http.NewRequest(http.MethodGet, ts.URL+"/.within.website/x/cmd/anubis/api/pass-challenge?"+q.Encode(), nil)
+			if err != nil {
+				t.Fatalf("can't make request: %v", err)
+			}
+			req.Header.Set("User-Agent", "Mozilla/5.0")
+			if tt.host != "" {
+				req.Host = tt.host
+			}
+			if tt.proto != "" {
+				req.Header.Set("X-Forwarded-Proto", tt.proto)
+			}
+			if tt.withCookie {
+				req.AddCookie(&http.Cookie{Name: srv.cookieName(anubis.TestCookieName), Value: c.ID})
+			}
+
+			cli := &http.Client{
+				CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+			}
+			resp, err := cli.Do(req)
+			if err != nil {
+				t.Fatalf("can't do request: %v", err)
+			}
+			t.Cleanup(func() { _ = resp.Body.Close() })
+
+			if resp.StatusCode != tt.wantStatus {
+				t.Fatalf("redir %q: wanted status %d, got %d", redir, tt.wantStatus, resp.StatusCode)
+			}
+			gotAuth := authCookie(srv, resp) != nil
+			if wantAuth := tt.withCookie && tt.wantStatus == http.StatusFound; gotAuth != wantAuth {
+				t.Fatalf("redir %q: wanted auth cookie %v, got %v", redir, wantAuth, gotAuth)
+			}
+			if tt.wantStatus == http.StatusFound {
+				if loc := resp.Header.Get("Location"); loc != redir {
+					t.Fatalf("redir %q: redirected to %q", redir, loc)
+				}
+			} else if loc := resp.Header.Get("Location"); loc != "" {
+				t.Fatalf("redir %q: refused, yet redirected to %q", redir, loc)
+			}
+		})
+	}
+}
