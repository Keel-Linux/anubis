+++ b/lib/redirect_same_host_test.go
@@ -0,0 +1,57 @@
+package lib
+
+import (
+	"net/http/httptest"
+	"net/url"
+	"testing"
+)
+
+// TestRedirectAllowed makes sure that, while REDIRECT_DOMAINS is empty,
+// pass-challenge redirects only to the origin the request came to
+// (scheme, host and port), or to a relative URL, so that every name the
+// site is reached by works and the open redirect stays closed; and that
+// a configured REDIRECT_DOMAINS still decides as before.
+func TestRedirectAllowed(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		host    string
+		proto   string
+		redir   string
+		domains []string
+		want    bool
+	}{
+		{name: "relative path", host: "web.example.org", proto: "https", redir: "/page?x=1", want: true},
+		{name: "same host", host: "web.example.org", proto: "https", redir: "https://web.example.org/page", want: true},
+		{name: "same host, other case", host: "Web.Example.org", proto: "https", redir: "https://web.example.ORG/", want: true},
+		{name: "same host, default port written", host: "web.example.org", proto: "https", redir: "https://web.example.org:443/", want: true},
+		{name: "a name not in /etc/hosts", host: "unlisted.keel.test", proto: "https", redir: "https://unlisted.keel.test/", want: true},
+		{name: "same IPv4", host: "10.0.3.86", proto: "https", redir: "https://10.0.3.86/", want: true},
+		{name: "same IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[fd42:b2:0:1::6554]/x", want: true},
+		{name: "other IPv6 literal", host: "[fd42:b2:0:1::6554]", proto: "https", redir: "https://[2001:db8::1]/", want: false},
+		{name: "other host", host: "web.example.org", proto: "https", redir: "https://evil.example/", want: false},
+		{name: "scheme-relative other host", host: "web.example.org", proto: "https", redir: "//evil.example/", want: false},
+		{name: "userinfo naming the host", host: "web.example.org", proto: "https", redir: "https://web.example.org@evil.example/", want: false},
+		{name: "userinfo on the same host", host: "web.example.org", proto: "https", redir: "https://a@web.example.org/", want: false},
+		{name: "other port", host: "web.example.org", proto: "https", redir: "https://web.example.org:8443/", want: false},
+		{name: "other scheme", host: "web.example.org", proto: "https", redir: "http://web.example.org/", want: false},
+		{name: "no X-Forwarded-Proto is http", host: "web.example.org", proto: "", redir: "http://web.example.org/", want: true},
+		{name: "a scheme with no host", host: "web.example.org", proto: "https", redir: "https:/page", want: false},
+		{name: "REDIRECT_DOMAINS allows a listed host", host: "web.example.org", proto: "https", redir: "https://other.example/", domains: []string{"other.example"}, want: true},
+		{name: "REDIRECT_DOMAINS refuses the request's own host when unlisted", host: "web.example.org", proto: "https", redir: "https://web.example.org/", domains: []string{"other.example"}, want: false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			req := httptest.NewRequest("GET", "/.within.website/x/cmd/anubis/api/pass-challenge", nil)
+			req.Host = tt.host
+			if tt.proto != "" {
+				req.Header.Set("X-Forwarded-Proto", tt.proto)
+			}
+			redir, err := url.Parse(tt.redir)
+			if err != nil {
+				t.Fatalf("cannot parse %q: %v", tt.redir, err)
+			}
+			if got := redirectAllowed(req, redir, tt.domains); got != tt.want {
+				t.Errorf("redirectAllowed(Host %q, %q) = %v, want %v", tt.host, tt.redir, got, tt.want)
+			}
+		})
+	}
+}
