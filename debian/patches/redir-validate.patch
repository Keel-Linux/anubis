+++ b/lib/redirect_validate_test.go
@@ -0,0 +1,82 @@
+package lib
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/TecharoHQ/anubis"
+)
+
+// TestPassChallengeRefusesRedirectTricks drives PassChallenge itself with
+// redir values that browsers resolve to another host although they have
+// neither scheme nor host in Go's parse: a backslash (`/\evil` is `//evil`
+// to a browser), an encoded slash or backslash, and leading whitespace or
+// control bytes. None may come back as a redirect; each is refused as an
+// invalid redirect before the challenge is looked at. A same-origin redir
+// passes that check and fails later, on the made-up challenge.
+func TestPassChallengeRefusesRedirectTricks(t *testing.T) {
+	srv := spawnAnubis(t, Options{
+		Next:   http.NewServeMux(),
+		Policy: loadPolicies(t, "testdata/aggressive_403.yaml", 0),
+	})
+
+	pass := func(redir string) *httptest.ResponseRecorder {
+		q := url.Values{
+			"id":          {"00000000-0000-0000-0000-000000000000"},
+			"response":    {"00"},
+			"nonce":       {"0"},
+			"elapsedTime": {"1"},
+			"redir":       {redir},
+		}
+		req := httptest.NewRequest("GET", "/.within.website/x/cmd/anubis/api/pass-challenge?"+q.Encode(), nil)
+		req.Host = "web.example.org"
+		req.Header.Set("X-Forwarded-Proto", "https")
+		req.Header.Set("X-Real-IP", "127.0.0.1")
+		req.Header.Set("User-Agent", "CHALLENGE")
+		req.AddCookie(&http.Cookie{Name: srv.cookieName(anubis.TestCookieName), Value: "x"})
+		w := httptest.NewRecorder()
+		srv.PassChallenge(w, req)
+		return w
+	}
+
+	for _, redir := range []string{
+		`/\evil.example`,
+		`/\/evil.example`,
+		`\\evil.example`,
+		`/%2F/evil.example`,
+		`/%2f%2fevil.example`,
+		`/%5Cevil.example`,
+		`/%5cevil.example`,
+		"\t//evil.example",
+		"%09//evil.example",
+		" //evil.example",
+		"//evil.example",
+		"/x\r\nLocation: https://evil.example/",
+		"evil.example",
+		"javascript:alert(1)",
+		"https:evil.example",
+		"",
+	} {
+		t.Run(redir, func(t *testing.T) {
+			w := pass(redir)
+			if loc := w.Header().Get("Location"); loc != "" {
+				t.Fatalf("redir %q: redirected to %q", redir, loc)
+			}
+			if !strings.Contains(w.Body.String(), "Invalid redirect") && !strings.Contains(w.Body.String(), "Redirect domain not allowed") {
+				t.Fatalf("redir %q: not refused as a redirect (status %d)", redir, w.Code)
+			}
+		})
+	}
+
+	for _, redir := range []string{"/page?x=1", "https://web.example.org/page"} {
+		t.Run("allowed "+redir, func(t *testing.T) {
+			body := pass(redir).Body.String()
+			if strings.Contains(body, "Invalid redirect") || strings.Contains(body, "Redirect domain not allowed") {
+				t.Fatalf("redir %q: refused as a redirect", redir)
+			}
+		})
+	}
+}
