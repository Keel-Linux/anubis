Description: Refuse redir forms a browser resolves to another host
 redir-same-host.patch allowed a redir with neither scheme nor host, and
 Go parses `/\evil.example` that way, while browsers read `/\` as `//`:
 http.Redirect sent it unchanged and the visitor landed on evil.example.
 This backports the checks of upstream's validateRedirect (after
 1.27.0): no backslash, no control byte, no leading space, no opaque URL,
 no path starting with `//`, a relative redir must start with `/`, only
 http and https. They run on redir as given and again once it is
 percent-decoded, so `/%2F/evil` and `/%5Cevil` are refused too; a
 refusal answers "Invalid redirect" with 400 before the challenge is
 looked up. TestPassChallengeRefusesRedirectTricks drives PassChallenge
 with those forms, whitespace and CRLF among them, and checks that a
 relative and a same-origin redir still pass.
Origin: backport, https://github.com/TecharoHQ/anubis/blob/main/lib/http.go (validateRedirect)
Author: Marcos Mendez <mendez.foto@gmail.com>
Bug: https://github.com/Keel-Linux/anubis/pull/3
Forwarded: not-needed
Last-Update: 2026-10-02
---
--- a/lib/anubis.go
+++ b/lib/anubis.go
@@ -496,6 +496,61 @@ func (s *Server) MakeChallenge(w http.Re
 	}
 }
 
+var errInvalidRedirectForm = errors.New("invalid redirect")
+
+// validateRedirectForm refuses a redir that a browser would resolve to
+// another host although Go parses it with neither scheme nor host, as
+// upstream's validateRedirect (after 1.27.0) does: a backslash (browsers
+// read `/\evil` as `//evil`), a control byte, leading whitespace, an
+// opaque URL, a path starting with `//`, a relative redir that does not
+// start with `/`, and anything else than http and https. The same checks
+// run again on the percent-decoded string, so `/%2F/evil` and `/%5Cevil`
+// are refused too.
+func validateRedirectForm(redir string) error {
+	if redir == "" {
+		return errInvalidRedirectForm
+	}
+	if err := redirectFormLooksSafe(redir); err != nil {
+		return err
+	}
+	decoded, err := url.PathUnescape(redir)
+	if err != nil {
+		return fmt.Errorf("%w: %w", errInvalidRedirectForm, err)
+	}
+	return redirectFormLooksSafe(decoded)
+}
+
+func redirectFormLooksSafe(redir string) error {
+	if strings.HasPrefix(redir, " ") || strings.ContainsAny(redir, "\\") {
+		return errInvalidRedirectForm
+	}
+	for _, c := range redir {
+		if c < 0x20 || c == 0x7f {
+			return errInvalidRedirectForm
+		}
+	}
+	u, err := url.Parse(redir)
+	if err != nil {
+		return fmt.Errorf("%w: %w", errInvalidRedirectForm, err)
+	}
+	if u.Opaque != "" {
+		return errInvalidRedirectForm
+	}
+	switch u.Scheme {
+	case "":
+		if u.Host != "" || !strings.HasPrefix(redir, "/") || strings.HasPrefix(u.Path, "//") {
+			return errInvalidRedirectForm
+		}
+	case "http", "https":
+		if u.Hostname() == "" {
+			return errInvalidRedirectForm
+		}
+	default:
+		return errInvalidRedirectForm
+	}
+	return nil
+}
+
 // redirectAllowed says whether pass-challenge may send the client to
 // redir. A URL with userinfo never. A relative URL (no host, no scheme)
 // always, as before. An absolute one: when allowed (REDIRECT_DOMAINS) is
@@ -554,6 +609,11 @@ func (s *Server) PassChallenge(w http.Re
 	localizer := localization.GetLocalizer(r)
 
 	redir := r.FormValue("redir")
+	if err := validateRedirectForm(redir); err != nil {
