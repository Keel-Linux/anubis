# Environment of anubis@default.service. Every flag of anubis can be set
# here by its upper-case name (anubis --help lists them).
#
# The instance does not start until /etc/anubis/default.key exists: the
# hex-encoded ed25519 seed that signs the challenge cookies, mode 0600,
# owned by root. Every node behind the same address must hold the same
# key, or a visitor moved to another node solves the challenge again.
#   install -m 0600 /dev/null /etc/anubis/default.key
#   openssl rand -hex 32 > /etc/anubis/default.key

# Loopback only: Anubis sits behind the web server, never at the edge.
BIND=127.0.0.1:8923
BIND_NETWORK=tcp
METRICS_BIND=127.0.0.1:9090
METRICS_BIND_NETWORK=tcp

# Where allowed requests go: http://host:port or unix:///path/to.sock
TARGET=http://127.0.0.1:3000

POLICY_FNAME=/etc/anubis/botPolicies.yaml
SERVE_ROBOTS_TXT=false
